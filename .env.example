# Copy this file to .env.local and fill in values from your Firebase project's
# Web App config (console.firebase.google.com > Project settings > Your apps).
# .env.local is gitignored — these keys are not secret (Firestore security
# rules are what actually protect the data) but env vars keep them out of
# source control anyway, matching normal practice.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — Epic 2's map plate (src/components/MapPlate.tsx). Without this,
# the map still renders, using MapLibre's free public demo style; add a
# MapTiler key (free tier: https://cloud.maptiler.com) here for real
# cartography instead of the demo tiles.
VITE_MAPTILER_KEY=
